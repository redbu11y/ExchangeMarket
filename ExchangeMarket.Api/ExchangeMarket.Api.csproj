<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UserSecretsId>aspnet-ExchangeMarket.Api-eb96d0a7-0233-4b5a-ac1b-6e78b0db5ebf</UserSecretsId>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.*" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.*" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.*">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" NoWarn="NU1605" />
        <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.12" NoWarn="NU1605" />
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
        <PackageReference Include="Microsoft.Identity.Web" Version="3.15.1" />
        <PackageReference Include="Microsoft.Identity.Web.DownstreamApi" Version="3.15.1" />
        <PackageReference Include="Scalar.AspNetCore" Version="3.2.0" />

    </ItemGroup>

</Project>
